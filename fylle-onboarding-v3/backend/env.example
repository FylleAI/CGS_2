# Fylle Onboarding v3 - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8001
DEBUG=true
LOG_LEVEL=INFO

# =============================================================================
# SUPABASE (Required)
# =============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# =============================================================================
# LLM PROVIDERS (At least one required)
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# Google Gemini (API Key method)
GEMINI_API_KEY=...
GEMINI_MODEL=gemini-1.5-pro

# Google Gemini (Vertex AI method - recommended for production)
USE_VERTEX_GEMINI=false
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# DeepSeek
DEEPSEEK_API_KEY=...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Perplexity (for research)
PERPLEXITY_API_KEY=pplx-...
PERPLEXITY_MODEL=sonar-pro

# =============================================================================
# DEFAULT PROVIDER
# =============================================================================
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_RESEARCH_PROVIDER=perplexity

# =============================================================================
# CORS (Frontend URLs)
# =============================================================================
CORS_ORIGINS=["http://localhost:3002", "http://localhost:5173"]
